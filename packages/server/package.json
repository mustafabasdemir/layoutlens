{
  "name": "@layoutlens/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-only scanning API that connects LayoutLens Studio to the scanner",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "layoutlens-server": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@layoutlens/core": "workspace:*",
    "@layoutlens/report": "workspace:*",
    "@layoutlens/shared": "workspace:*",
    "@layoutlens/visual": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
